NODE_ENV=development
# Porta usada pelo servidor Express; em produção, a hospedagem pode fornecer este valor.
# Use 5000 localmente; em produção, o Railway fornece process.env.PORT.
PORT=5000
# Origem permitida do frontend local ou publicado.
FRONTEND_URL=http://localhost:5173
# Chave privada usada para assinar e validar tokens JWT.
JWT_SECRET=troque-por-uma-chave-aleatoria-longa
# Caminho opcional para o arquivo JSON de dados persistentes.
# Por padrão, os dados ficam em backend/data/app-data.json.
EMBRASMECT_DATA_FILE=